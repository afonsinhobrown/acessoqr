# Base de dados (Neon)
DATABASE_URL=postgres://user:password@host/db?sslmode=require
TEST_DATABASE_URL=postgres://user:password@host/test_db?sslmode=require

# Servidor
PORT=3000
PUBLIC_URL=http://localhost:3000

# Segredos da aplicação
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
WEBHOOK_SECRET=troque-por-um-segredo-de-webhook
# Chave AES-256 (32 bytes) em base64 para cifrar destinos de reembolso.
# Em produção é obrigatória; gere com: openssl rand -base64 32
REFUND_ENC_KEY=

# QR Ed25519 em base64 DER (PKCS8 / SPKI). Sem elas é gerada uma chave efémera.
QR_PRIVATE_KEY=
QR_PUBLIC_KEY=
QR_TTL=30
QR_TOLERANCIA=5

# Email (POST JSON {para,assunto,texto})
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# PaySuite
PAYSUITE_API_URL=https://paysuite.tech/api/v1
PAYSUITE_API_TOKEN=
PAYSUITE_WEBHOOK_SECRET=
